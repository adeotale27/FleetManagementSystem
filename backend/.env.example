MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=fleet_db
JWT_SECRET=change-this-to-a-long-random-string

# Business owner (New Naidu Transport) — role: owner
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123

# Platform owner (licence control) — role: superadmin — open /platform after login
PLATFORM_USERNAME=superadmin
PLATFORM_PASSWORD=super123

# Optional: file uploads (logo / documents). App still runs without this.
# EMERGENT_LLM_KEY=
# INTEGRATION_PROXY_URL=
